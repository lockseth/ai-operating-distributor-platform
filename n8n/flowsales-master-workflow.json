              "value": "={{ \"🎉 *ORDER BESAR MASUK!*\\n\\nPelanggan: *\" + ($json.trigger_data.customer_name ?? \"-\") + \"*\\nNilai: *Rp \" + Number($json.trigger_data.order_amount ?? 0).toLocaleString('id-ID') + \"*\\nSales: \" + ($json.trigger_data.sales_name ?? \"-\") + \"\\n\\nPastikan stok & pengiriman siap!\\n\\n_FlowSales AI_\" }}",
              "type": "string"
            },
            {
