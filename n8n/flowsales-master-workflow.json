      "id": "55555555-eeee-4000-8000-000000000016",
      "name": "Kirim Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1680, 280],
      "notes": "Sales (repeat_order_due, churn_risk operasional) SELALU lewat Telegram. Token bot via env TELEGRAM_BOT_TOKEN, TIDAK di-hardcode."
