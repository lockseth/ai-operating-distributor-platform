      "id": "55555555-eeee-4000-8000-000000000004",
      "name": "Format: Repeat Order",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [960, 120],
      "notes": "Kanal Sales = Telegram (bukan WhatsApp), sesuai aturan kanonik channel-routing."
    },
    {
      "parameters": {
        "jsCode": "// churn_risk operasional -> SELALU Telegram ke Sales.\n// Eskalasi WhatsApp ke Owner/Manager HANYA bila risiko serius\n// (days_inactive > 45, sejalan ambang HIGH churn risk di\n// lib/ai/features/churn-prediction.ts & lib/ai/features/executive-summary.ts).\n// TIDAK PERNAH fallback ke sales_phone/nomor Sales untuk node WhatsApp.\nconst data = $json.trigger_data ?? {};\nconst ruleName = $json.rule_name;\nconst ruleId = $json.rule_id;\nconst daysInactive = Number(data.days_inactive ?? 0);\nconst isSerious = daysInactive > 45;\n\nconst items = [\n  {\n    json: {\n      channel: 'telegram',\n      recipient: data.telegram_chat_id ?? '',\n      message_text: \"⚠️ *CHURN RISK*\\n\\nPelanggan *\" + (data.customer_name ?? '-') + \"* tidak order selama *\" + daysInactive + \" hari*.\\n\\nSales: \" + (data.sales_name ?? '-') + \"\\n📞 \" + (data.customer_phone ?? '-') + \"\\n\\nSegera follow-up!\\n\\n_FlowSales AI_\",\n      rule_name: ruleName,\n      rule_id: ruleId,\n    },\n  },\n];\n\nif (isSerious) {\n  items.push({\n    json: {\n      channel: 'whatsapp',\n      recipient: data.owner_phone ?? data.manager_phone ?? '',\n      message_text: \"🚨 *ESKALASI CHURN RISK — ACTION REQUIRED*\\n\\nPelanggan *\" + (data.customer_name ?? '-') + \"* belum order selama *\" + daysInactive + \" hari*.\\n\\nSales PIC: \" + (data.sales_name ?? '-') + \"\\n📞 \" + (data.customer_phone ?? '-') + \"\\n\\n_FlowSales AI_\",\n      rule_name: ruleName,\n      rule_id: ruleId,\n    },\n  });\n}\n\nreturn items;\n"
      },
      "id": "55555555-eeee-4000-8000-000000000005",
      "name": "Format: Churn Risk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 280]
    },
    {
