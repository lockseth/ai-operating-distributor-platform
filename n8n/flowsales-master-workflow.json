    {
      "parameters": {
        "method": "POST",
        "url": "https://api.whatsapp-provider.example.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={\n  \"to\": \"{{ $json.recipient }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"{{ $json.message_text }}\"\n  }\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "55555555-eeee-4000-8000-000000000009",
      "name": "Kirim WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1680, 440],
      "notes": "Owner/Manager saja (large_order, daily_summary, eskalasi serius churn_risk). GANTI url dengan endpoint WhatsApp API provider Anda. Tambahkan credential.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "whatsapp-api-cred",
          "name": "WhatsApp API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Ambil rule_id/rule_name/channel/recipient dari node 'Gabung Branch'\n// (BUKAN dari $json) -- output HTTP Request node Kirim Telegram/Kirim\n// WhatsApp menimpa $json dengan response body provider, jadi field custom\n// hilang kalau dibaca langsung dari $json di sini.\nconst crypto = require('crypto');\n\nconst secret = $env['N8N_WEBHOOK_SECRET'] ?? 'GANTI_DENGAN_SECRET_ANDA';\nconst source = $('Gabung Branch').item.json;\n\nconst payload = {\n  event: 'webhook_processed',\n  source: 'n8n',\n  rule_id: source.rule_id,\n  rule_name: source.rule_name,\n  status: 'success',\n  channel: source.channel,\n  sent_to: source.recipient,\n  processed_at: new Date().toISOString()\n};\n\nconst bodyString = JSON.stringify(payload);\nconst signature = crypto\n  .createHmac('sha256', secret)\n  .update(bodyString)\n  .digest('hex');\n\nreturn [{\n  json: {\n    callbackPayload: payload,\n    callbackBody: bodyString,\n    callbackSignature: `sha256=${signature}`\n  }\n}];\n"
      },
      "id": "55555555-eeee-4000-8000-000000000010",
      "name": "Hitung HMAC Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FLOWSALES_APP_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-flowsales-signature",
              "value": "={{ $json.callbackSignature }}"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.callbackBody }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "55555555-eeee-4000-8000-000000000011",
      "name": "Callback ke FlowSales",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2160, 360]
    },
