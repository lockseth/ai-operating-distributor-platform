            "index": 0
          }
        ]
      ]
    },
    "GET /health": {
      "main": [
        [
          {
            "node": "Status != healthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Status != healthy?": {
      "main": [
        [],
        [
          {
            "node": "Healthy (No-Op)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
