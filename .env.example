# =============================================================================
# AODP — Environment Variables
# Copy this file to .env.local (root) dan apps/web/.env.local, lalu isi nilainya.
# NEVER commit .env.local to git.
# =============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook
# N8N_WEBHOOK_SECRET: TIDAK DIPAKAI LAGI oleh POST /api/webhooks/n8n sejak
# Webhook Security Hardening (2026-07-15). Autentikasi inbound n8n sekarang
# per-tenant lewat tabel n8n_inbound_credentials (Bearer token, hash
# tersimpan) — lihat docs/architecture/TELEGRAM_SALES_ORDER_ENTRY.md.
# Variabel ini boleh dikosongkan untuk deployment baru.
N8N_WEBHOOK_SECRET=

# Telegram Sales Order Entry — apps/web/src/app/api/webhooks/telegram
# TELEGRAM_BOT_TOKEN: token dari @BotFather ("123456:ABC-DEF...").
# TELEGRAM_WEBHOOK_SECRET: string rahasia buatan sendiri (mis. openssl rand -hex 32),
#   dipasang saat setWebhook via parameter secret_token — Telegram akan
#   mengirimkannya kembali di header X-Telegram-Bot-Api-Secret-Token pada
#   setiap update. Wajib diisi; tanpa ini webhook selalu menolak request.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=generate-a-random-secret
# Username bot tanpa @, dipakai untuk membuat deep-link enrollment Salesman.
# Contoh: AODP_WaluyoBot. Bila kosong, UI tetap menampilkan command manual.
TELEGRAM_BOT_USERNAME=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AODP

# Login page branding — HANYA aktif ketika NEXT_PUBLIC_APP_ENV="demo" (lihat
# apps/web/src/lib/branding/login-branding.ts). Non-secret, aman untuk build
# publik. Kosongkan/biarkan tidak diset untuk preview/pilot/production.
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_DEMO_COMPANY_NAME=

# Automation dry-run — HANYA "false" (eksplisit) yang mengizinkan pengiriman
# Telegram sungguhan lewat /dispatch (lihat lib/n8n-automation/service.ts).
# Default aman (dry-run) bila tidak diset. Set eksplisit "false" hanya saat
# integrasi Telegram sungguhan sudah siap diuji live.
AUTOMATION_DRY_RUN=
